{
  "__inputs": [],
  "__elements": {},
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.3.3" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Bitcoin Volatility ML - Pipeline Monitoring",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "postgres", "uid": "btcdb-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 0 },
      "id": 1,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "btcdb-postgres" },
          "format": "time_series",
          "rawSql": "SELECT window_start AS time, close AS \"BTC Close (USD)\" FROM btc_ohlc_1m WHERE $__timeFilter(window_start) ORDER BY window_start",
          "refId": "A"
        }
      ],
      "title": "BTC/USDT - Harga Close (1 Menit)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "btcdb-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 1,
          "min": -1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": -0.2 },
              { "color": "green", "value": 0.2 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 2,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "btcdb-postgres" },
          "format": "table",
          "rawSql": "SELECT avg_sentiment FROM sentiment_hourly ORDER BY hour_timestamp DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "title": "Sentimen Twitter (rata-rata per jam)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "postgres", "uid": "btcdb-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "btcdb-postgres" },
          "format": "time_series",
          "rawSql": "SELECT timestamp AS time, predicted_volatility AS \"Prediksi Volatilitas\", actual_volatility AS \"Aktual Volatilitas\" FROM predictions WHERE $__timeFilter(timestamp) ORDER BY timestamp",
          "refId": "A"
        }
      ],
      "title": "Prediksi vs Aktual Volatilitas",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "btcdb-postgres" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "btcdb-postgres" },
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS \"Total OHLC (24 jam)\" FROM btc_ohlc_1m WHERE window_start > NOW() - INTERVAL '24 hours'",
          "refId": "A"
        },
        {
          "datasource": { "type": "postgres", "uid": "btcdb-postgres" },
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS \"Prediksi (24 jam)\" FROM predictions WHERE timestamp > NOW() - INTERVAL '24 hours'",
          "refId": "B"
        },
        {
          "datasource": { "type": "postgres", "uid": "btcdb-postgres" },
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS \"Sentimen Batch (7 hari)\" FROM sentiment_hourly WHERE hour_timestamp > NOW() - INTERVAL '7 days'",
          "refId": "C"
        }
      ],
      "title": "Statistik Pipeline",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "btcdb-postgres" },
      "fieldConfig": { "defaults": {} },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "options": { "sortBy": [{ "displayName": "Waktu", "desc": true }] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "btcdb-postgres" },
          "format": "table",
          "rawSql": "SELECT event_time AS \"Waktu\", username AS \"User\", action AS \"Aksi\", table_name AS \"Tabel\", details AS \"Detail\" FROM audit_log ORDER BY event_time DESC LIMIT 50",
          "refId": "A"
        }
      ],
      "title": "Audit Log - 50 Event Terakhir",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["bitcoin", "volatility", "ml"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Bitcoin Volatility ML - Pipeline Monitoring",
  "uid": "btc-pipeline-monitoring",
  "version": 1
}