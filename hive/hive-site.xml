<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  hive/hive-site.xml
  Konfigurasi Hive Metastore:
  - Backend: PostgreSQL (database metastoredb)
  - Warehouse: MinIO bucket hive-warehouse
-->
<configuration>

  <!-- ─── PostgreSQL Backend ──────────────────────────────── -->
  <property>
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:postgresql://postgres:5432/metastoredb</value>
    <description>JDBC URL untuk PostgreSQL sebagai backend Hive Metastore</description>
  </property>

  <property>
    <name>javax.jdo.option.ConnectionDriverName</name>
    <value>org.postgresql.Driver</value>
  </property>

  <property>
    <name>javax.jdo.option.ConnectionUserName</name>
    <value>btcadmin</value>
  </property>

  <property>
    <name>javax.jdo.option.ConnectionPassword</name>
    <value>gantiPasswordAman123</value>
  </property>

  <!-- Auto-create schema di PostgreSQL jika belum ada -->
  <property>
    <name>datanucleus.schema.autoCreateSchema</name>
    <value>true</value>
  </property>

  <property>
    <name>datanucleus.schema.autoCreateTables</name>
    <value>true</value>
  </property>

  <!-- ─── Warehouse Location (MinIO) ──────────────────────── -->
  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>s3a://hive-warehouse/</value>
    <description>Lokasi default warehouse di MinIO</description>
  </property>

  <!-- ─── Thrift Server ───────────────────────────────────── -->
  <property>
    <name>hive.metastore.uris</name>
    <value>thrift://hive-metastore:9083</value>
  </property>

  <!-- min harus < max, dan max harus eksplisit lebih besar dari min -->
  <property>
    <name>hive.metastore.server.min.threads</name>
    <value>10</value>
  </property>

  <property>
    <name>hive.metastore.server.max.threads</name>
    <value>100</value>
  </property>

  <!-- Port Thrift eksplisit -->
  <property>
    <name>hive.metastore.port</name>
    <value>9083</value>
  </property>

  <!-- ─── S3A / MinIO Config ──────────────────────────────── -->
  <property>
    <name>fs.s3a.endpoint</name>
    <value>http://minio:9000</value>
  </property>

  <property>
    <name>fs.s3a.access.key</name>
    <value>minioadmin</value>
  </property>

  <property>
    <name>fs.s3a.secret.key</name>
    <value>minioadmin123</value>
  </property>

  <property>
    <name>fs.s3a.path.style.access</name>
    <value>true</value>
  </property>

  <property>
    <name>fs.s3a.connection.ssl.enabled</name>
    <value>false</value>
  </property>

  <property>
    <name>fs.s3a.impl</name>
    <value>org.apache.hadoop.fs.s3a.S3AFileSystem</value>
  </property>

  <!-- ─── Metastore event listener (opsional) ─────────────── -->
  <property>
    <name>hive.metastore.event.db.notification.api.auth</name>
    <value>false</value>
  </property>

</configuration>