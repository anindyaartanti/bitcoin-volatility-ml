# ── PostgreSQL ──────────────────────────────────────────────
APP_DB_HOST=localhost
APP_DB_PORT=5434
APP_DB_NAME=btcdb
APP_DB_USER=kelompok4_ipbd
APP_DB_PASSWORD=k4ipbd_postgres_2026

POSTGRES_USER=kelompok4_ipbd
POSTGRES_PASSWORD=k4ipbd_postgres_2026
POSTGRES_DB_APP=btcdb
POSTGRES_DB_AIRFLOW=airflowdb
POSTGRES_DB_MLFLOW=mlflowdb
# ← BARU: tambah metastore
POSTGRES_MULTIPLE_DATABASES=btcdb,airflowdb,mlflowdb,metastoredb,prefectdb

# ── MinIO ───────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=k4ipbd_minio_2026

# ── Prefect ────────────────────────────────────────────────
PREFECT_API_URL=http://prefect-server:4200/api
SENTIMENT_LOOKBACK_HOURS=6

# ── Twitter / Sentiment ──────────────────────────────────────
TWITTER_AUTH_TOKEN=your_twitter_bearer_token_here
TWITTER_SCRAPE_LIMIT=200

# ── Spark ────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2

# ── MLflow ───────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts
# MLflow pakai kredensial MinIO untuk artifact storage
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=k4ipbd_minio_2026

# ── Hive Metastore ───────────────────────────────────────────
HIVE_METASTORE_DB_HOST=postgres
HIVE_METASTORE_DB_PORT=5432
HIVE_METASTORE_DB_NAME=metastoredb
HIVE_METASTORE_DB_USER=kelompok4_ipbd
HIVE_METASTORE_DB_PASSWORD=k4ipbd_postgres_2026

# ── Trino ────────────────────────────────────────────────────
TRINO_HOST=trino
TRINO_PORT=8082
